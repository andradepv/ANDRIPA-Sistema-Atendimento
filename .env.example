# Copie para .env. NUNCA coloque credenciais reais neste arquivo de exemplo.
ANDRIPA_ENVIRONMENT=development
POSTGRES_PASSWORD=atende-dev
# Em produção, DATABASE_URL e REDIS_URL vêm do AWS Secrets Manager.
ANDRIPA_DATABASE_URL=postgresql+psycopg://atende:atende-dev@localhost:5432/atende
ANDRIPA_REDIS_URL=redis://localhost:6379/0
# Endereço que vai no QR Code / NFC (frontend). Em dev, o Vite roda em :5173.
ANDRIPA_PUBLIC_BASE_URL=http://localhost:5173
ANDRIPA_ALLOWED_ORIGINS=http://localhost:5173
# Em HTTP local os cookies não podem ser "Secure". Em homologação/produção: true.
ANDRIPA_COOKIE_SECURE=false
ANDRIPA_LOG_LEVEL=INFO
# Web Push (opcional). Gere com: python -m app.cli gen-vapid
ANDRIPA_VAPID_PUBLIC_KEY=
ANDRIPA_VAPID_PRIVATE_KEY=
ANDRIPA_VAPID_SUBJECT=mailto:contato@example.com
# Senha dos usuários de demonstração criados por `python -m app.cli seed-dev`
ANDRIPA_DEV_PASSWORD=troque-esta-senha
